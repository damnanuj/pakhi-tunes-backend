{
  "info": {
    "_postman_id": "a1b2c3d4-pakhi-tunes-backend",
    "name": "Pakhi Tunes Backend",
    "description": "REST API for the Pakhi Tunes backend. Edit the collection variable `baseUrl` (default http://localhost:8000). Requests use `url` as a string so `{{baseUrl}}` stays visible and resolves in Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "REPLACE_WITH_MONGODB_OBJECT_ID",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "REPLACE_WITH_JWT_FROM_AUTH_LOGIN",
      "type": "string"
    },
    {
      "key": "songToken",
      "value": "REPLACE_WITH_SONG_ID_TOKEN",
      "type": "string"
    },
    {
      "key": "artistId",
      "value": "REPLACE_WITH_ARTIST_ID",
      "type": "string"
    },
    {
      "key": "artistSlug",
      "value": "REPLACE_WITH_ARTIST_SLUG",
      "type": "string"
    },
    {
      "key": "artistEncryptedId",
      "value": "REPLACE_WITH_ENCRYPTED_ID",
      "type": "string"
    },
    {
      "key": "albumId",
      "value": "REPLACE_WITH_ALBUM_ID",
      "type": "string"
    },
    {
      "key": "albumSlug",
      "value": "REPLACE_WITH_ALBUM_SLUG",
      "type": "string"
    },
    {
      "key": "albumEncryptedId",
      "value": "REPLACE_WITH_ENCRYPTED_ID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Liveness check. Does not require a database."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/{{userId}}",
            "description": "Fetch your own profile. Requires JWT; userId must match the authenticated user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "App Config",
      "item": [
        {
          "name": "Get app config",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/app-config",
            "description": "Public read for update dialog flags, version, and release notes."
          },
          "response": []
        },
        {
          "name": "Update app config",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"updateAvailable\": true,\n  \"forceUpdate\": false,\n  \"latestVersion\": \"1.1.0\",\n  \"downloadUrl\": \"https://example.com/download\",\n  \"updateTitle\": \"Update Available\",\n  \"updateMessage\": \"A new version is available.\",\n  \"releaseSections\": [\n    {\n      \"title\": \"What's new\",\n      \"items\": [\"Bug fixes\", \"Performance improvements\"]\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/app-config",
            "description": "Admin-only partial update. Requires JWT for a user with role: admin (set in MongoDB). Re-login after promoting."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Top artists",
      "item": [
        {
          "name": "List top artists",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/top-artists?limit=20&offset=0",
            "description": "Paginated top artists from the scraper. Query: limit, offset."
          },
          "response": []
        },
        {
          "name": "Artist songs (by artistId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/top-artists/{{artistId}}/songs?limit=20&offset=0",
            "description": "Songs for an artist using the `:artistId/songs` path."
          },
          "response": []
        },
        {
          "name": "Artist songs (by encrypted id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/top-artists/{{artistEncryptedId}}?limit=20&offset=0",
            "description": "Same handler as songs list: single path segment treated as encrypted id."
          },
          "response": []
        },
        {
          "name": "Artist songs (by slug + encrypted id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/top-artists/{{artistSlug}}/{{artistEncryptedId}}?limit=20&offset=0",
            "description": "Artist songs using slug and encrypted id path."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Songs",
      "item": [
        {
          "name": "Get song by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/songs/{{songToken}}",
            "description": "Song details by token/id. Server needs `SCRAPER_SOURCE_BASE_URL` set."
          },
          "response": []
        }
      ]
    },
    {
      "name": "New releases",
      "item": [
        {
          "name": "List new releases",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/new-releases?limit=20&offset=0&language=",
            "description": "Paginated new releases. Query: limit, offset, optional language."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Albums",
      "item": [
        {
          "name": "Album songs (by albumId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/albums/{{albumId}}/songs?limit=20&offset=0",
            "description": "Tracks for an album via `:albumId/songs`."
          },
          "response": []
        },
        {
          "name": "Album songs (by slug + encrypted id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/albums/{{albumSlug}}/{{albumEncryptedId}}/songs?limit=20&offset=0",
            "description": "Tracks for an album via `:albumSlug/:encryptedId/songs`."
          },
          "response": []
        }
      ]
    }
  ]
}
