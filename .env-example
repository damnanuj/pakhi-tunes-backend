# Render: do not set PORT or NODE_ENV — Render sets these automatically.
# Do not set VERCEL on Render.

# Required — startup fails without MONGODB_URI
MONGODB_URI=

# Required — use a strong secret in production (not the jwt.js dev fallback)
JWT_SECRET=

# Optional
JWT_EXPIRES_IN=7d

# Firebase Admin (required for Google sign-in)
# From Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value; keep \n escapes or wrap in quotes with real newlines
FIREBASE_PRIVATE_KEY=

# Required for scraper/search endpoints
SCRAPER_SOURCE_BASE_URL=

# Presence stats (Live now, sessions, duration on admin dashboard) are written only when
# mobile clients send trackStats: true (preview/production EAS builds). Development builds
# skip heartbeats; no server env is required for this gate.
#
# Listening analytics (per-user song stats, live now-playing, guest 120-min limit) use the
# same trackStats gate on POST /listening/report and presence heartbeats with currentTrack.
