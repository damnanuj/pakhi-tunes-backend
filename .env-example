# Render: do not set PORT or NODE_ENV — Render sets these automatically.
# Do not set VERCEL on Render.

# Required — startup fails without MONGODB_URI
MONGODB_URI=

# Required — use a strong secret in production (not the jwt.js dev fallback)
JWT_SECRET=

# Optional
JWT_EXPIRES_IN=7d

# Required for scraper/search endpoints
SCRAPER_SOURCE_BASE_URL=
